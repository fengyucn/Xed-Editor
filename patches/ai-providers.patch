+package com.rk.ai.provider
+
+import com.rk.settings.Preference
+
+/** Caches a provider's model list fetched from its `/models` endpoint. */
+object AiModelStore {
+    private fun key(providerId: String) =
+        "ai_models_cache_" + providerId.replace(Regex("[^A-Za-z0-9_-]"), "_")
+
+    /** Returns null when nothing has been fetched yet (fall back to the built-in list). */
+    fun load(providerId: String): List<AiModel>? {
+        val raw = Preference.getString(key(providerId), "")
+        if (raw.isBlank()) return null
+        return raw.lineSequence()
+            .mapNotNull { line ->
+                val parts = line.split('\t')
+                val id = parts.getOrNull(0)?.trim().orEmpty()
+                if (id.isEmpty()) null
+                else
+                    AiModel(
+                        id = id,
+                        providerId = providerId,
+                        displayName = parts.getOrNull(1)?.trim()?.ifBlank { id } ?: id,
+                        contextWindowTokens = parts.getOrNull(2)?.toIntOrNull(),
+                    )
+            }
+            .toList()
+            .ifEmpty { null }
+    }
+
+    fun save(providerId: String, models: List<AiModel>) {
+        Preference.setString(
+            key(providerId),
+            models.joinToString("\n") { m ->
+                listOfNotNull(m.id, m.displayName, m.contextWindowTokens?.toString()).joinToString("\t")
+            },
+        )
+    }
+
+    fun clear(providerId: String) = Preference.setString(key(providerId), "")
+}
