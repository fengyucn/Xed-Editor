+
+private fun parseModelList(body: String, providerId: String): List<AiModel> {
+    val data = runCatching { JSONObject(body).optJSONArray("data") }.getOrNull() ?: return emptyList()
+    return (0 until data.length()).mapNotNull { index ->
+        val item = data.optJSONObject(index) ?: return@mapNotNull null
+        val modelId = item.optString("id").trim()
+        if (modelId.isEmpty()) return@mapNotNull null
+        val name = item.optString("name").trim().ifEmpty { modelId }
+        val context =
+            when {
+                    item.has("context_length") -> item.optInt("context_length")
+                    item.has("context_window") -> item.optInt("context_window")
+                    else -> item.optJSONObject("top_provider")?.optInt("context_length") ?: 0
+                }
+                .takeIf { it > 0 }
+        AiModel(id = modelId, providerId = providerId, displayName = name, contextWindowTokens = context)
+    }
+}
